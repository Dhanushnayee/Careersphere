# ==============================================================================
# CAREERSPHERE AI — ENVIRONMENT CONFIGURATION TEMPLATE (PHASE 1)
# ==============================================================================
# Copy this file to .env and adjust values for your local development setup.
# In production, ensure all secrets are supplied via secure vault or CI/CD secrets.
# NEVER commit a real .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-careersphere-ai-foundation-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_SETTINGS_MODULE=careersphere_ai.settings.development

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=careersphere_db
DB_USER=careersphere_user
DB_PASSWORD=careersphere_secure_dev_password_2026
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY ASYNCHRONOUS TASK INFRASTRUCTURE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. AI ENGINE & RESUME COPILOT INTEGRATION (PLANNED PHASE 4)
# ------------------------------------------------------------------------------
# Google Gemini API key or Vertex AI service account credentials.
# In Phase 1, the backend exposes schema endpoints; real calls arrive in Phase 4.
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 6. EMAIL & OTP AUTHENTICATION (PLANNED PHASE 2)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=PLACEHOLDER_FOR_SENDGRID_KEY
DEFAULT_FROM_EMAIL=no-reply@careersphere.ai

# Resend Email Delivery API for Real OTP Verification
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 7. N8N AUTOMATION PIPELINE (AUTONOMOUS MULTI-APPLY)
# ------------------------------------------------------------------------------
# Set your n8n webhook URL to receive autonomous multi-job application events
N8N_WEBHOOK_URL=http://localhost:5678/webhook/careersphere-multi-apply

# ------------------------------------------------------------------------------
# 8. SECURITY & UPLOAD LIMITS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
